# ==========================================
# POSTGRES DATABASE CONFIGURATION
# ==========================================
POSTGRES_DB=udaan_db
POSTGRES_USER=udaan_user
POSTGRES_PASSWORD=replace_with_strong_password_in_production

# ==========================================
# DJANGO BACKEND CONFIGURATION
# ==========================================
DJANGO_SECRET_KEY=replace_with_long_random_django_secret_key_in_production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.org,api.yourdomain.org,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://yourdomain.org,http://localhost
CORS_ALLOWED_ORIGINS=https://yourdomain.org,http://localhost
DONATION_GAP_DAYS=90
FIREBASE_CREDENTIALS_PATH=/app/secrets/serviceAccountKey.json

# ==========================================
# FRONTEND CONFIGURATION (Vite)
# ==========================================
VITE_USE_MOCK=false
VITE_API_URL=/api
VITE_GOOGLE_MAPS_KEY=your_production_google_maps_key
VITE_RAZORPAY_KEY=rzp_live_your_razorpay_key

# ==========================================
# FRONTEND CONFIGURATION (Next.js Compatibility)
# ==========================================
NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_production_google_maps_key
NEXT_PUBLIC_RAZORPAY_KEY=rzp_live_your_razorpay_key
